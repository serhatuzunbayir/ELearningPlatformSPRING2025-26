@model learning_platform.Models.StudyPlanDto
@{
    ViewData["Title"] = "Study Plan";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="font-weight-bold">Your Study Plan</h1>
        @if (Model == null)
        {
            <form asp-action="Generate" method="post">
                <button type="submit" class="btn btn-primary" style="border-radius: 10px;">
                    <i class="bi bi-magic"></i> Generate Plan
                </button>
            </form>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @{
        var recommendations = ViewBag.Recommendations as List<learning_platform.Models.RecommendedCourseDto>;
    }
    @if (recommendations != null && recommendations.Any())
    {
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px;">
            <div class="card-body">
                <h5 class="font-weight-bold mb-3"><i class="bi bi-lightbulb"></i> Recommended courses for you</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var r in recommendations)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <div>
                                <strong>@r.Title</strong>
                                <span class="badge bg-primary ms-2">@r.Category</span>
                                <div class="small text-muted">@r.Reason</div>
                            </div>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (Model == null)
    {
        <div class="text-center mt-5 p-5 border rounded bg-light">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h3 class="mt-4 font-weight-bold">No Study Plan Found</h3>
            <p class="text-muted">You don't have a study plan yet. Click "Generate Plan" to let the system generate a personalized study plan based on your progress, enrolled courses, and ECTS credit load.</p>
        </div>
    }
    else
    {
        <div class="alert alert-info" style="border-radius: 10px;">
            <i class="bi bi-info-circle"></i> This plan was generated on <strong>@Model.GeneratedAt.ToString("g")</strong>.
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
            @{
                var groupedItems = Model.Items.GroupBy(i => i.ScheduledDay).OrderBy(g => g.Key);
            }
            @foreach (var dayGroup in groupedItems)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 h-100" style="border-radius: 15px;">
                        <div class="card-header bg-primary text-white font-weight-bold" style="border-top-left-radius: 15px; border-top-right-radius: 15px;">
                            <i class="bi bi-calendar-event"></i> @dayGroup.Key
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var item in dayGroup)
                            {
                                <li class="list-group-item py-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary">@item.Category</span>
                                        <span class="text-primary font-weight-bold"><i class="bi bi-clock"></i> @item.RecommendedHours h</span>
                                    </div>
                                    <h6 class="mb-0 font-weight-bold">@item.CourseTitle</h6>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
        
        <div class="text-center mt-5">
            <form asp-action="Generate" method="post">
                <button type="submit" class="btn btn-outline-primary" style="border-radius: 10px;">
                    <i class="bi bi-arrow-repeat"></i> Regenerate Plan
                </button>
            </form>
        </div>
    }
</div>
