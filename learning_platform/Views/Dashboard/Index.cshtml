@model learning_platform.Models.ProgressSummaryDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="font-weight-bold">Welcome back, @User.Identity?.Name! 🎓</h1>
        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger" style="border-radius: 10px;">
                <i class="bi bi-box-arrow-right"></i> Sign Out
            </button>
        </form>
    </div>

    @if (Model != null)
    {
        <div class="row mb-5">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-primary text-white" style="border-radius: 15px;">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-book"></i> Enrolled Courses</h5>
                        <h2 class="display-4 font-weight-bold">@Model.TotalEnrolledCourses</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-success text-white" style="border-radius: 15px;">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-award"></i> Completed Courses</h5>
                        <h2 class="display-4 font-weight-bold">@Model.FullyCompletedCourses</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-info text-white" style="border-radius: 15px;">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-graph-up"></i> Overall Progress</h5>
                        <h2 class="display-4 font-weight-bold">@Model.OverallCompletionPercentage.ToString("0.0")%</h2>
                    </div>
                </div>
            </div>
        </div>

        <h3 class="mb-3 font-weight-bold">Your Active Courses</h3>
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var course in Model.Courses)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 h-100" style="border-radius: 15px;">
                        <div class="card-body">
                            <h5 class="card-title font-weight-bold">@course.CourseTitle</h5>
                            <p class="text-muted mb-2">Modules completed: @course.CompletedModules / @course.TotalModules</p>
                            
                            <div class="progress" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @course.CompletionPercentage%;" aria-valuenow="@course.CompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-end">
                            <a asp-controller="Progress" asp-action="Course" asp-route-id="@course.CourseId" class="btn btn-primary btn-sm" style="border-radius: 8px;">
                                Continue Course <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Courses.Any())
            {
                <div class="col-12 text-center mt-4">
                    <div class="p-5 border rounded-3 bg-light">
                        <i class="bi bi-journal-x text-muted display-1"></i>
                        <h4 class="mt-3">No Active Courses</h4>
                        <p class="text-muted">You are not enrolled in any courses yet, or your enrollments are pending approval.</p>
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg mt-2" style="border-radius: 10px;">Browse Courses</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>
