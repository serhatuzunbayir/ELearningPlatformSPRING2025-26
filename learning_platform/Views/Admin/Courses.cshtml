@model List<learning_platform.Models.CourseListDto>
@{
    ViewData["Title"] = "Manage Courses";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="font-weight-bold"><i class="bi bi-journal-text"></i> Manage Courses</h1>
        <a asp-action="CreateCourse" class="btn btn-success" style="border-radius: 10px;">
            <i class="bi bi-plus-circle"></i> New Course
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Category</th>
                            <th>Difficulty</th>
                            <th class="text-center">ECTS</th>
                            <th class="text-center">Modules</th>
                            <th class="text-center">Enrolled</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@course.Title</td>
                                <td><span class="badge bg-primary rounded-pill">@course.Category</span></td>
                                <td><span class="badge bg-secondary rounded-pill">@course.Difficulty</span></td>
                                <td class="text-center">@course.EctsCredit</td>
                                <td class="text-center">@course.ModuleCount</td>
                                <td class="text-center">@course.EnrollmentCount</td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditCourse" asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-primary" style="border-radius: 8px;">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form asp-action="DeleteCourse" asp-route-id="@course.Id" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete course &quot;@course.Title&quot;? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-journal-x display-4 d-block mb-2"></i>
                                    No courses yet. Click "New Course" to add one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
