@model learning_platform.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="font-weight-bold">Welcome, @User.Identity?.Name <i class="bi bi-shield-lock"></i></h1>
        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger" style="border-radius: 10px;">
                <i class="bi bi-box-arrow-right"></i> Sign Out
            </button>
        </form>
    </div>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-primary text-white" style="border-radius: 15px;">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-journal-text"></i> Total Courses</h5>
                    <h2 class="display-4 font-weight-bold">@Model.TotalCourses</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-warning text-white" style="border-radius: 15px;">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-hourglass-split"></i> Pending Enrollments</h5>
                    <h2 class="display-4 font-weight-bold">@Model.PendingEnrollments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-success text-white" style="border-radius: 15px;">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-people"></i> Approved Enrollments</h5>
                    <h2 class="display-4 font-weight-bold">@Model.TotalApprovedEnrollments</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 15px;">
                <div class="card-body">
                    <h4 class="font-weight-bold mb-3"><i class="bi bi-lightning-charge"></i> Quick Actions</h4>
                    <div class="d-grid gap-2">
                        <a asp-action="Courses" class="btn btn-primary btn-lg" style="border-radius: 10px;">
                            <i class="bi bi-journal-text"></i> Manage Courses
                        </a>
                        <a asp-action="Enrollments" class="btn btn-warning btn-lg text-white" style="border-radius: 10px;">
                            <i class="bi bi-hourglass-split"></i> Review Pending Enrollments
                        </a>
                        <a asp-action="CreateCourse" class="btn btn-success btn-lg" style="border-radius: 10px;">
                            <i class="bi bi-plus-circle"></i> Add New Course
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 15px;">
                <div class="card-body">
                    <h4 class="font-weight-bold mb-3"><i class="bi bi-clock-history"></i> Latest Pending Requests</h4>

                    @if (Model.RecentPending.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var enr in Model.RecentPending)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold">@enr.StudentName</div>
                                        <small class="text-muted">@enr.CourseTitle</small>
                                    </div>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                </li>
                            }
                        </ul>
                        <div class="text-end mt-3">
                            <a asp-action="Enrollments" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;">
                                See All <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No pending enrollment requests right now.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
